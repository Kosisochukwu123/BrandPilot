generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  passwordHash     String?
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  isAdmin          Boolean            @default(false)
  suspended        Boolean            @default(false)
  onboardingDone   Boolean            @default(false)
  accounts         Account[]
  activityLogs     ActivityLog[]
  brands           Brand[]
  channels         Channel[]
  generatedContent GeneratedContent[]
  posters          Poster[]
  scheduledPosts   ScheduledPost[]
  sessions         Session[]
  subscription     Subscription?
  usage            UsageRecord[]

  @@map("users")
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  message   String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Brand {
  id               String             @id @default(cuid())
  userId           String
  websiteUrl       String?
  brandName        String?
  businessType     String?
  audience         String?
  tone             String?
  keywords         String[]           @default([])
  rawSummary       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  instagramHandle  String?
  whatsappNumber   String?
  reports          BrandReport[]
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedContent GeneratedContent[]

  @@index([userId])
  @@map("brands")
}

model BrandReport {
  id               String   @id @default(cuid())
  brandId          String
  score            Int
  scoreExplanation String
  summary          String
  audienceRatings  Json
  personality      Json
  voiceTags        String[]
  colors           String[]
  typography       String
  contentPillars   String[]
  platformRankings Json
  opportunities    Json
  createdAt        DateTime @default(now())
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("brand_reports")
}

model GeneratedContent {
  id             String          @id @default(cuid())
  userId         String
  brandId        String?
  type           ContentType
  prompt         String
  output         String
  createdAt      DateTime        @default(now())
  favorited      Boolean         @default(false)
  brand          Brand?          @relation(fields: [brandId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posters        Poster[]
  scheduledPosts ScheduledPost[]

  @@index([userId, type])
  @@map("generated_content")
}

model Channel {
  id                String          @id @default(cuid())
  userId            String
  type              ChannelType
  status            ChannelStatus   @default(CONNECTED)
  label             String?
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  externalAccountId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  recommendations   Json?
  recommendationsAt DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts    ScheduledPost[]

  @@unique([userId, type, externalAccountId])
  @@index([userId])
  @@map("channels")
}

model ScheduledPost {
  id           String            @id @default(cuid())
  userId       String
  channelId    String
  contentId    String?
  body         String
  mediaUrl     String?
  scheduledAt  DateTime
  status       PostStatus        @default(QUEUED)
  errorMessage String?
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  channel      Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  content      GeneratedContent? @relation(fields: [contentId], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([channelId, status])
  @@map("scheduled_posts")
}

model Poster {
  id                  String            @id @default(cuid())
  userId              String
  contentId           String?
  textMode            PosterTextMode
  headline            String
  imagePrompt         String
  backgroundUrl       String?
  finalUrl            String?
  status              PosterStatus      @default(GENERATING)
  errorMessage        String?
  createdAt           DateTime          @default(now())
  batchId             String?
  engagementLevel     String?
  explanationPoints   String[]          @default([])
  matchScore          Int?
  recommendedPlatform String?
  variationLabel      String?
  bullets             String[]          @default([])
  subheadline         String?
  templateId          String?
  ctaEmphasis         String?
  decorationHints     String[]          @default([])
  hierarchy           String?
  imageFocus          String?
  spacingMood         String?
  visualStyle         String?
  campaignGoal        String?
  concept             String?
  creativeStrategy    String?
  ctaSuggestion       String?
  imageMood           String?
  content             GeneratedContent? @relation(fields: [contentId], references: [id])
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("posters")
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  plan                     Plan               @default(FREE)
  status                   SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  authorizationCode        String?
  paystackCustomerCode     String?            @unique
  paystackSubscriptionCode String?            @unique
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageRecord {
  id              String @id @default(cuid())
  userId          String
  periodYearMonth String
  generations     Int    @default(0)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodYearMonth])
  @@map("usage_records")
}

model PosterAsset {
  id            String      @id @default(cuid())
  type          AssetType
  imageUrl      String
  transparent   Boolean     @default(false)
  businessTypes String[]    @default([])
  styleTags     String[]    @default([])
  colorTags     String[]    @default([])
  description   String
  source        AssetSource @default(LIBRARY)
  usageCount    Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([type])
  @@map("poster_assets")
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum ChannelType {
  INSTAGRAM
  FACEBOOK
  X
  WHATSAPP
}

enum ChannelStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum ContentType {
  INSTAGRAM_CAPTION
  FACEBOOK_POST
  LINKEDIN_POST
  X_POST
  EMAIL_CAMPAIGN
  PRODUCT_DESCRIPTION
  BLOG_IDEA
  AD_COPY
  SEO_META_TITLE
  SEO_META_DESCRIPTION
  SEO_KEYWORDS
  WHATSAPP_BROADCAST
}

enum PostStatus {
  DRAFT
  QUEUED
  PUBLISHED
  FAILED
}

enum PosterTextMode {
  OVERLAY
  BAKED_IN
}

enum PosterStatus {
  GENERATING
  READY
  FAILED
}

enum ActivityType {
  WEBSITE_ANALYZED
  BRAND_BRAIN_UPDATED
  CONTENT_GENERATED
  POSTER_GENERATED
  CONTENT_PUBLISHED
  CHANNEL_CONNECTED
}

enum AssetType {
  BACKGROUND
  OBJECT
  POSTER_REFERENCE
}

enum AssetSource {
  LIBRARY
  AI_SEEDED
}
